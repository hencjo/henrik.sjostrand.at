<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != "Home" %}{{ title }} · {% endif %}Henrik Sjöstrand</title>
  <meta name="description" content="Projects, open source contributions, and community work by Henrik Sjöstrand.">
  <meta name="color-scheme" content="light dark">
  <script>
    (function () {
      var t = localStorage.getItem("theme");
      if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
    })();
  </script>
  <link rel="stylesheet" href="/fonts/fraunces/full.css">
  <link rel="stylesheet" href="/fonts/ibm-plex-sans/400.css">
  <link rel="stylesheet" href="/fonts/ibm-plex-sans/400-italic.css">
  <link rel="stylesheet" href="/fonts/ibm-plex-sans/500.css">
  <link rel="stylesheet" href="/fonts/ibm-plex-sans/600.css">
  <link rel="stylesheet" href="/fonts/ibm-plex-sans/600-italic.css">
  <link rel="stylesheet" href="/fonts/ibm-plex-mono/400.css">
  <link rel="stylesheet" href="/fonts/ibm-plex-mono/400-italic.css">
  <link rel="stylesheet" href="/css/pico.min.css">
  <link rel="stylesheet" href="/site.css">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="Henrik Sjöstrand · Articles">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="container-fluid site-header">
    <nav aria-label="Main navigation">
      <ul>
        <li><a href="/" class="brand">Henrik Sjöstrand</a></li>
      </ul>
      <ul>
        <li class="theme-item">
          <button type="button" class="theme-toggle" id="theme-toggle" data-mode="system" aria-label="Color theme: system" title="Color theme: system">
            <span aria-hidden="true" id="theme-icon">
              <svg data-mode="system" width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
              <svg data-mode="light" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
              <svg data-mode="dark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
            </span>
          </button>
        </li>
        <li><a href="/articles/"{% if page.url and page.url.startsWith("/articles/") %} aria-current="page"{% endif %}>Articles</a></li>
        <li><a href="/projects/"{% if page.url and page.url.startsWith("/projects/") %} aria-current="page"{% endif %}>Projects</a></li>
        {% include "social-icons.njk" %}
      </ul>
    </nav>
  </header>

  <main class="container-fluid" id="main">
    {{ content | safe }}
  </main>

  <footer class="container-fluid site-footer">
    <small><a href="/about/">About</a> · <a href="/about/#contact">Contact</a> · <a href="https://github.com/hencjo">GitHub</a> · <a href="https://www.linkedin.com/in/hencjo/">LinkedIn</a></small>
  </footer>

  <script>
    (function () {
      var root = document.documentElement;
      var button = document.getElementById("theme-toggle");
      var order = ["system", "light", "dark"];

      function current() {
        return root.getAttribute("data-theme") || "system";
      }

      function render(mode) {
        button.dataset.mode = mode;
        var label = "Color theme: " + mode;
        button.setAttribute("aria-label", label);
        button.title = label;
      }

      button.addEventListener("click", function () {
        var next = order[(order.indexOf(current()) + 1) % order.length];
        if (next === "system") {
          root.removeAttribute("data-theme");
          localStorage.removeItem("theme");
        } else {
          root.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
        }
        render(next);
      });

      render(current());
    })();
  </script>
</body>
</html>
