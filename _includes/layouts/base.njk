<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != "Home" %}{{ title }} · {% endif %}Henrik Sjöstrand</title>
  <meta name="description" content="Projects, open source contributions, and community work by Henrik Sjöstrand.">
  <meta name="color-scheme" content="light dark">
  <script>
    (function () {
      var t = localStorage.getItem("theme");
      if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
    })();
  </script>
  <link rel="stylesheet" href="/css/pico.min.css">
  <link rel="stylesheet" href="/site.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="container-fluid site-header">
    <nav aria-label="Main navigation">
      <ul>
        <li><a href="/" class="brand">Henrik Sjöstrand</a></li>
      </ul>
      <ul>
        <li><a href="/projects/"{% if page.url and page.url.startsWith("/projects/") %} aria-current="page"{% endif %}>Projects</a></li>
        <li><a href="/oss/"{% if page.url == "/oss/" %} aria-current="page"{% endif %}>OSS</a></li>
        <li><a href="/community/"{% if page.url == "/community/" %} aria-current="page"{% endif %}>Community</a></li>
        <li>
          <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Color theme: system" title="Color theme: system">
            <span aria-hidden="true" id="theme-icon">◐</span>
          </button>
        </li>
      </ul>
    </nav>
  </header>

  <main class="container-fluid" id="main">
    {{ content | safe }}
  </main>

  <footer class="container-fluid site-footer">
    <small><a href="https://github.com/hencjo">GitHub</a> · <a href="https://www.linkedin.com/in/hencjo/">LinkedIn</a></small>
  </footer>

  <script>
    (function () {
      var root = document.documentElement;
      var button = document.getElementById("theme-toggle");
      var icon = document.getElementById("theme-icon");
      var order = ["system", "light", "dark"];
      var icons = { system: "◐", light: "☀", dark: "☾" };

      function current() {
        return root.getAttribute("data-theme") || "system";
      }

      function render(mode) {
        icon.textContent = icons[mode];
        var label = "Color theme: " + mode;
        button.setAttribute("aria-label", label);
        button.title = label;
      }

      button.addEventListener("click", function () {
        var next = order[(order.indexOf(current()) + 1) % order.length];
        if (next === "system") {
          root.removeAttribute("data-theme");
          localStorage.removeItem("theme");
        } else {
          root.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
        }
        render(next);
      });

      render(current());
    })();
  </script>
</body>
</html>
