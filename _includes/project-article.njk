{# Renders one project article. Expects: p (data), pdate, purl, body, linkTitle. #}
<article class="post">
  <header class="post-hero">
    <p class="meta">
      <time datetime="{{ pdate | htmlDateString }}">{{ pdate | readableDate }}</time>
      {% if p.url %}<a href="{{ p.url }}">{{ p.url | replace("https://", "") }}</a>{% endif %}
    </p>
    <h1>{% if linkTitle %}<a href="{{ purl }}">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</h1>
    {% if p.summary %}<p class="lead">{{ p.summary }}</p>{% endif %}
    {% if p.pitch %}
    <p class="pitch">{{ p.pitch }}</p>
    {% endif %}
  </header>

  <div class="post-body">
    {{ body | safe }}
  </div>
</article>
